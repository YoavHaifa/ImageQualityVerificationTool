IDR_MENU1 MENU
BEGIN
    POPUP "File"
    BEGIN
        MENUITEM "Open Dicom",                  ID_FILE_OPEN32771
        MENUITEM "Batch Scoring",               ID_FILE_BATCHSCORING
        MENUITEM "Open Case Scoring",           ID_FILE_OPENCASESCORING
        MENUITEM "Open Batch Scoring",          ID_FILE_OPENBATCHSCORING
        MENUITEM "Exit",                        ID_FILE_EXIT
    END
    POPUP "Test"
    BEGIN
        MENUITEM "Find Dicom Sets",             ID_TEST_FINDDICOMSETS
    END
    POPUP "Utils"
    BEGIN
        MENUITEM "Download Data",               ID_UTILS_DOWNLOADDATA
    END
    POPUP "Label"
    BEGIN
        MENUITEM "Save All Case As Passed",     ID_LABEL_SAVEALLASPASSED
        POPUP "Save All Case As Failed"
        BEGIN
            MENUITEM "Center",                  ID_LABEL_SAVEALLASFAILED_CENTER
            MENUITEM "Ring",                    ID_LABEL_SAVEALLASFAILED_RING
            MENUITEM "Both",                    ID_LABEL_SAVEALLASFAILED_BOTH
        END
        MENUITEM "Save Section As Passed",      ID_LABEL_SAVESECTIONASPASSED
        POPUP "Save Section As Failed"
        BEGIN
            MENUITEM "Center",                  ID_LABEL_SAVESECTIONASFAILED_CENTER
            MENUITEM "Ring",                    ID_LABEL_SAVESECTIONASFAILED_RING
            MENUITEM "Both",                    ID_LABEL_SAVESECTIONASFAILED_BOTH
        END
    END
    POPUP "Optimize"
    BEGIN
        MENUITEM "Score Training Data",         ID_OPTIMIZE_SCORETRAININGDATA
        MENUITEM "Optimize Scorer Weights",     ID_OPTIMIZE_SCOREWEIGHTS
        MENUITEM "Show Training Data Plot",     ID_OPTIMIZE_SHOWPLOT
    END
END


