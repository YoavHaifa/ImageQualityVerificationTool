IDD_ABOUTBOX DIALOGEX 0, 0, 235, 55
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "About IQV_tool"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,11,17,20,20
    LTEXT           "IQV_tool Version 1.0",IDC_STATIC,40,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2008",IDC_STATIC,40,25,119,8
    DEFPUSHBUTTON   "OK",IDOK,178,7,50,16,WS_GROUP
END

IDD_IQV_DIALOG DIALOGEX 5, 5, 520, 194
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Image Quality Verification App"
MENU IDR_MENU1
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Shared Memory Display",IDC_BUTTON_SHARED,7,7,110,14,NOT WS_VISIBLE
    LTEXT           "Leaf Between Cases:",IDC_STATIC_LEAF_CASES,7,9,90,8
    PUSHBUTTON      "Previous Case",IDC_BUTTON_PREV_CASE,100,7,65,14
    PUSHBUTTON      "Worst Case",IDC_BUTTON_WORST_CASE,173,7,65,14
    PUSHBUTTON      "Next Case",IDC_BUTTON_NEXT_CASE,246,7,65,14
    LTEXT           "Case",IDC_STATIC_CASE_INDEX,323,9,150,8
    LTEXT           "Leaf in Current Case:",IDC_STATIC,7,28,90,8
    PUSHBUTTON      "Previous",IDC_BUTTON_PREV,100,26,65,14
    PUSHBUTTON      "Max Score",IDC_BUTTON_MAX,173,26,65,14
    PUSHBUTTON      "Next",IDC_BUTTON_NEXT,246,26,65,14
    EDITTEXT        IDC_EDIT_I_IMAGE,96,62,40,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Image",IDC_STATIC,62,65,21,8
    EDITTEXT        IDC_EDIT_SCORE,181,62,40,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Score",IDC_STATIC,149,65,19,8
    LTEXT           "Score Type",IDC_STATIC,62,92,45,8
    COMBOBOX        IDC_COMBO_SCORE_TYPE,120,89,80,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Batch Status",IDC_STATIC_BATCH_STATUS,7,117,506,8
    LTEXT           "Current Set",IDC_STATIC_IMAGESET,7,131,506,8,0,WS_EX_RIGHT
    LTEXT           "Status Line",IDC_STATIC_STATUS,7,145,506,8
    LTEXT           "Score Detail",IDC_STATIC_SCORE_DETAIL,7,159,506,8
    EDITTEXT        IDC_EDIT_RADIUS,269,62,40,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Radius",IDC_STATIC,234,65,22,8
    EDITTEXT        IDC_EDIT_SOURCE_SCORER,352,62,60,14,ES_AUTOHSCROLL | ES_READONLY
    LTEXT           "Source",IDC_STATIC_SOURCE_SCORER,318,65,30,8
    PUSHBUTTON      "Exit",IDC_OK,365,173,50,14
    PUSHBUTTON      "Cancel",IDC_CANCEL,428,173,50,14
END

IDD_BATCH_COMPLETE DIALOGEX 0, 0, 340, 110
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Batch Scoring"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "",IDC_STATIC_BATCH_COMPLETE_MSG,7,7,326,70
    DEFPUSHBUTTON   "Review Results",IDOK,158,85,75,14
    PUSHBUTTON      "Close",IDCANCEL,241,85,60,14
END

IDD_TRAINING_PLOT DIALOGEX 0, 0, 420, 360
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Training Data: Raw Score vs Data Range"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    LTEXT           "Score Type",IDC_STATIC,7,10,45,8
    COMBOBOX        IDC_COMBO_PLOT_TYPE,55,7,80,120,CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "",IDC_STATIC_PLOT_LEGEND,145,10,268,8
    LTEXT           "Click a point to identify its case",IDC_STATIC_PLOT_SELECTED,7,336,343,10
    PUSHBUTTON      "Close",IDCANCEL,363,333,50,14
END


